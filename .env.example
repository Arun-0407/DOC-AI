# ============================================================
# SAP DocGen AI — Environment Configuration Template
# ============================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://docai:CHANGE_ME@localhost:5432/docai_db

# --- JWT Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# --- CORS (comma-separated origins in JSON array) ---
CORS_ORIGINS=["https://your-domain.com","http://localhost:3000"]

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ─── AI Engine ─── (choose BTP or OpenAI) ──────────────────
# Option A: SAP BTP AI Core (Claude)
BTP_CLIENT_ID=
BTP_CLIENT_SECRET=
BTP_TOKEN_URL=https://<subaccount>.authentication.eu10.hana.ondemand.com/oauth/token
BTP_AI_API_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com
BTP_RESOURCE_GROUP=default
BTP_DEPLOYMENT_ID=

# Option B: OpenAI (fallback when BTP not configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── SAP System Connection ──────────────────────────────────
# The /sap/bc/zdoc ICF service must be active on the SAP system.
SAP_DOC_API_URL=https://your-s4-host:port/sap/bc/zdoc
SAP_DOC_API_CLIENT=100
SAP_DOC_API_VERIFY_SSL=true
SAP_DOC_API_TIMEOUT=120
# Leave USER/PASSWORD blank to require per-request credentials (recommended)
SAP_DOC_API_USER=
SAP_DOC_API_PASSWORD=

# ─── BTP Destination Service (optional) ─────────────────────
SAP_BTP_DESTINATION_NAME=
SAP_BTP_DESTINATION_SERVICE_URL=

# ─── Legacy RFC Bridge (disabled by default) ────────────────
SAP_RFC_ENABLED=false
SAP_BRIDGE_PORT=5001

# ─── Legacy ADT (disabled by default) ───────────────────────
SAP_ADT_ENABLED=false

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api
