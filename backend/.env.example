# ── Copy this file to backend/.env and fill in your values ──────────────────
# NEVER commit .env to Git — it contains real credentials.
# Required keys are marked [REQUIRED]; the app will not start without them.

# ── Database [REQUIRED] ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/docai_db

# ── JWT [REQUIRED] ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Left empty on purpose so the app refuses to start until a real secret is set.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# ── CORS / Uploads ───────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ── AI Engine: SAP BTP AI Core (primary) ─────────────────────────────────────
BTP_CLIENT_ID=
BTP_CLIENT_SECRET=
BTP_TOKEN_URL=
BTP_AI_API_URL=
BTP_RESOURCE_GROUP=default
BTP_DEPLOYMENT_ID=

# ── AI Engine: OpenAI (fallback, used when BTP is not configured) ────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── SAP Doc HTTP API (PRIMARY SAP source: ICF /sap/bc/zdoc) ──────────────────
# Handler ZCL_DOC_HTTP → ZCL_DOC_READER  (?action=search | ?action=read)
SAP_DOC_API_URL=https://<sap_host>:<https_port>/sap/bc/zdoc
SAP_DOC_API_USER=
SAP_DOC_API_PASSWORD=
SAP_DOC_API_CLIENT=120
SAP_DOC_API_VERIFY_SSL=true          # false only for self-signed certificates
SAP_DOC_API_TIMEOUT=120
SAP_CACHE_MINUTES=30

# ── SAP RFC (OPTIONAL legacy fallback — needs NW RFC SDK) ────────────────────
SAP_RFC_ENABLED=false                # true = auto-start sap_rfc_bridge.js
SAP_HOST=
SAP_SYSNR=00
SAP_CLIENT=120
SAP_USER=
SAP_PASSWORD=
SAP_LANG=EN
SAPNWRFC_HOME=                       # required only when SAP_RFC_ENABLED=true
RFC_INI=
SAP_BRIDGE_PORT=5001
SAP_BRIDGE_URL=http://127.0.0.1:5001

# ── SAP ADT/HTTP (OPTIONAL legacy fallback) ──────────────────────────────────
SAP_ADT_ENABLED=false
SAP_S4_HOST=
SAP_S4_CLIENT=120
SAP_S4_AUTH_MODE=basic               # basic | oauth
SAP_S4_BASIC_USER=
SAP_S4_BASIC_PASS=
SAP_S4_OAUTH_TOKEN_URL=
SAP_S4_OAUTH_CLIENT_ID=
SAP_S4_OAUTH_CLIENT_SECRET=
SAP_S4_VERIFY_SSL=true
SAP_S4_TIMEOUT=60
SAP_S4_MAX_DEPTH=3